# Maintainer: Adrian Granados <support at intuitibits dot com>

pkgname=scandump
pkgver=2.3.0
pkgrel=1
pkgdesc='Command-line utility that writes Wi-Fi scan results in PCAP format'
arch=('x86_64' 'aarch64' 'armv7h' 'i686')
url='https://github.com/intuitibits/scandump'
license=('GPL-3.0-only')
depends=('glibc' 'libnl' 'libpcap')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a708ca58fb1bdd7f84df63051fe38ea0ab5acf472af6e1bc21bbc7d24a29fe99')

build() {
  cd "$pkgname-$pkgver"
  make WERROR=
}

check() {
  cd "$pkgname-$pkgver"
  make check WERROR=
  ./scandump --version | grep -qx "scandump version $pkgver"
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 examples/sudoers -t "$pkgdir/usr/share/doc/$pkgname/examples"
}
